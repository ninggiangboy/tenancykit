{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billing.io/events/charge.succeeded.schema.json",
  "title": "Charge succeeded",
  "description": "A charge was recorded against a wallet and a ledger entry posted. This schema describes the `data` member of the delivered document; the envelope (id, type, tenantId, occurredAt, data) is described in README.md.",
  "type": "object",
  "required": [
    "chargeId",
    "walletId",
    "entryId",
    "amount",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "chargeId": {
      "type": "string",
      "format": "uuid"
    },
    "walletId": {
      "type": "string",
      "format": "uuid"
    },
    "entryId": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "source": {
      "type": "string",
      "enum": [
        "USAGE",
        "RESERVATION",
        "STANDALONE"
      ]
    },
    "usageRef": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reservationId": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "grossAmount": {
      "$ref": "#/$defs/money"
    },
    "discounts": {
      "type": "array",
      "description": "One entry per coupon that took part, in the order the engine applied them.",
      "items": {
        "type": "object",
        "required": [
          "redemptionId",
          "couponId",
          "couponName",
          "benefitType",
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "redemptionId": {
            "type": "string",
            "format": "uuid"
          },
          "couponId": {
            "type": "string",
            "format": "uuid"
          },
          "couponName": {
            "type": "string"
          },
          "benefitType": {
            "type": "string",
            "enum": [
              "PERCENT_OFF",
              "AMOUNT_OFF",
              "WALLET_CREDIT"
            ]
          },
          "amount": {
            "$ref": "#/$defs/money"
          }
        }
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "description": "An amount in minor units (cents, dong) of one ISO 4217 currency.",
      "required": [
        "minorUnits",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "minorUnits": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
