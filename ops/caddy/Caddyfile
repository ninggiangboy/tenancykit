# The suite's reverse proxy. It only routes; it adds no logic, retries nothing and rewrites no body.
#
# Tenant resolution stays hostname-based, so the proxy must forward the original Host header — Caddy does by
# default. Billing reads `<tenant-code>.<base-domain>` to pick the tenant, so a proxy that rewrote Host to the
# upstream name would break every tenant request.
#
# Routes:
#   /platform/*    -> Platform, with the /platform prefix stripped, on every host. The Host is kept, so a request
#                     to acme.localhost/platform/... is a tenant-scoped Platform call for tenant acme.
#   /notification/* -> Notification, prefix stripped.
#   /mailroom/*    -> Mailroom, prefix stripped; /mailroom/t/* is the public tracking surface.
#   everything else -> Billing (/api/*, /portal/*, /stripe/*), unchanged.
#   platform.localhost also serves Platform at its root, because an administrator works from that one host.
#
# The listener is plain HTTP on port 80 with automatic TLS off: this is a local stack, and `*.localhost` resolves to
# 127.0.0.1, where a self-signed certificate would only get in the way. A named host would otherwise make Caddy
# redirect every request to https.

{
	admin off
	auto_https off
	servers {
		protocols h1 h2c
	}
	log {
		output stdout
		format console
	}
}

http://:80 {
	@platformPath path /platform/*
	handle @platformPath {
		uri strip_prefix /platform
		reverse_proxy platform:8080
	}

	# Notification is a fourth app, reached through its own prefix on every host — including platform.localhost, where a
	# Platform user reads their own inbox. Caddy picks the first matching `handle`, so this rule must sit before the
	# platform-host rule below; otherwise platform.localhost/notification/... would be answered by Platform and a
	# Platform user would have no inbox.
	@notificationPath path /notification/*
	handle @notificationPath {
		uri strip_prefix /notification
		reverse_proxy notification-api:8080
	}

	# Mailroom is the fifth app, reached through its own prefix on every tenant host. The public tracking paths live under
	# the same prefix (`/mailroom/t/...`); they need no credentials because the proxy adds none, and the HMAC-signed token
	# in the path is their proof. A per-IP rate limit belongs here in a deployment that needs one; the stock Caddy image
	# has no rate-limit directive, so the application's own per-email-per-minute cap is the bound this stack ships.
	@mailroomPath path /mailroom/*
	handle @mailroomPath {
		uri strip_prefix /mailroom
		reverse_proxy mailroom-api:8080
	}

	@platformHost host platform.localhost
	handle @platformHost {
		reverse_proxy platform:8080
	}

	handle {
		reverse_proxy billing:8080
	}
}
