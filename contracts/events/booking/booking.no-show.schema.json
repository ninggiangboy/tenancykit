{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/events/booking/booking.no-show.schema.json",
  "title": "Booking no-show",
  "description": "A confirmed booking's time passed without the customer arriving and the Tenant marked it. The claims stay as history; nothing is released. Booking reports the fact and the Tenant decides its own policy. The event's `aggregate` is `booking/<bookingId>`. This schema describes the `data` member; the envelope is described in ../../messaging/README.md.",
  "type": "object",
  "required": [
    "bookingId",
    "bookingVersion",
    "status",
    "customerRef",
    "offeringId",
    "offeringKind",
    "source",
    "qty",
    "resources",
    "noShowAt",
    "policyCode",
    "occurredAt"
  ],
  "additionalProperties": false,
  "properties": {
    "bookingId": { "type": "string", "format": "uuid" },
    "bookingVersion": { "type": "integer", "minimum": 1 },
    "status": { "const": "NO_SHOW" },
    "customerRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "offeringId": { "type": "string", "format": "uuid" },
    "offeringKind": { "enum": ["INTERVAL", "CAPACITY"] },
    "source": { "enum": ["TENANT", "GATE", "WAITLIST"] },
    "qty": { "type": "integer", "minimum": 1 },
    "sessionId": { "type": ["string", "null"], "format": "uuid" },
    "poolCode": { "type": ["string", "null"], "maxLength": 60 },
    "startsAt": { "type": ["string", "null"], "format": "date-time" },
    "endsAt": { "type": ["string", "null"], "format": "date-time" },
    "resources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["slotCode", "resourceId"],
        "additionalProperties": false,
        "properties": {
          "slotCode": { "type": "string", "maxLength": 60 },
          "resourceId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "seriesId": { "type": ["string", "null"], "format": "uuid" },
    "noShowAt": { "type": "string", "format": "date-time" },
    "policyCode": { "const": "NO_SHOW", "description": "Always `NO_SHOW`, so a receiver routes it without reading the type." },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "bookingId": "0198c1a0-0000-7000-8000-00000000b001",
      "bookingVersion": 3,
      "status": "NO_SHOW",
      "customerRef": "cust-9001",
      "offeringId": "0198c1a0-0000-7000-8000-00000000a002",
      "offeringKind": "INTERVAL",
      "source": "TENANT",
      "qty": 1,
      "startsAt": "2026-11-19T09:00:00Z",
      "endsAt": "2026-11-19T10:00:00Z",
      "resources": [
        { "slotCode": "staff", "resourceId": "0198c1a0-0000-7000-8000-00000000f001" }
      ],
      "noShowAt": "2026-11-19T10:05:00Z",
      "policyCode": "NO_SHOW",
      "occurredAt": "2026-11-19T10:05:00Z"
    }
  ]
}
