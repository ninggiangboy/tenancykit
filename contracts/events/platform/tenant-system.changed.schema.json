{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/events/platform/tenant-system.changed.schema.json",
  "title": "Tenant system changed",
  "description": "The full current state of one Tenant System: a third-party application integrated with one Tenant. A consumer upserts by id when `version` is newer. This schema describes the `data` member; the envelope is described in ../../messaging/README.md.",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "name",
    "purpose",
    "status",
    "created_at",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "GENERIC",
        "WORKFLOW"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "DISABLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
