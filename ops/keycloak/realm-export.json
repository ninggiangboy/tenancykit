{
  "realm": "tenancykit",
  "displayName": "TenancyKit",
  "enabled": true,
  "sslRequired": "external",
  "loginTheme": "suite",
  "browserFlow": "suite-browser",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "resetCredentialsFlow": "suite-reset-credentials",
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "attributes": {
    "actionTokenGeneratedByUserLifespan.reset-credentials": "900"
  },
  "accessTokenLifespan": 300,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_code\",\"displayName\":\"Tenant code\",\"validations\":{\"length\":{\"max\":40}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant id\",\"validations\":{\"length\":{\"max\":36}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "suite-console",
      "name": "Suite Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://platform.localhost:5173/*",
        "http://localhost/console/*",
        "http://platform.localhost/console/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://platform.localhost:5173/*##http://localhost/console/*##http://platform.localhost/console/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_code",
            "claim.name": "tenant_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "platform",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "billing-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "billing",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "notification-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "notification",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mailroom-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mailroom",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "survey-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "survey",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "customer-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "customer",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "loyalty-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "loyalty",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "booking-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "booking",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "workflow-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "workflow",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-admin",
      "name": "Platform identity administration",
      "enabled": true,
      "publicClient": false,
      "secret": "${PLATFORM_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "kc-admin-api",
        "roles",
        "profile",
        "basic",
        "email"
      ]
    },
    {
      "clientId": "suite-smoke",
      "name": "Suite smoke test (development only)",
      "description": "Lets ops/smoke/suite-smoke.sh obtain user tokens with a direct grant. It exists only in this development realm export and must never be imported into a real deployment.",
      "enabled": true,
      "publicClient": false,
      "secret": "${SMOKE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "platform",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "billing-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "billing",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "notification-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "notification",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mailroom-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mailroom",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "survey-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "survey",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "customer-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "customer",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "loyalty-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "loyalty",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "booking-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "booking",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "workflow-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "workflow",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-platform-admin",
      "enabled": true,
      "serviceAccountClientId": "platform-admin",
      "clientRoles": {
        "realm-management": [
          "manage-clients",
          "manage-users",
          "view-clients",
          "view-users"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "suite-browser",
      "description": "Browser flow whose username form looks a person up inside the tenant the console named",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "suite-browser-forms",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "suite-browser-forms",
      "description": "Username, password and a second factor when the person has one",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "suite-tenant-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "suite-browser-conditional-otp",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "suite-browser-conditional-otp",
      "description": "Asks for a one-time code only when the person has one configured",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "suite-reset-credentials",
      "description": "Reset credentials whose first step looks a person up inside the tenant the console named",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "suite-tenant-reset-choose-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "reset-credential-email",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "reset-password",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 40,
          "flowAlias": "suite-reset-conditional-otp",
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "suite-reset-conditional-otp",
      "description": "Resets the one-time code too, only when the person has one configured",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "reset-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ]
}
