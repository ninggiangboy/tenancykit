{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/events/booking/booking.rescheduled.schema.json",
  "title": "Booking rescheduled",
  "description": "A booking moved to a new place or time in one transaction: either the booking is at the new place or it is unchanged. The event carries the booking's complete current state plus the place it left, so a receiver can reconcile both. The event's `aggregate` is `booking/<bookingId>`. This schema describes the `data` member; the envelope is described in ../../messaging/README.md.",
  "type": "object",
  "required": [
    "bookingId",
    "bookingVersion",
    "status",
    "customerRef",
    "offeringId",
    "offeringKind",
    "source",
    "qty",
    "resources",
    "previous",
    "occurredAt"
  ],
  "additionalProperties": false,
  "properties": {
    "bookingId": { "type": "string", "format": "uuid" },
    "bookingVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["HELD", "CONFIRMED"] },
    "customerRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "offeringId": { "type": "string", "format": "uuid" },
    "offeringKind": { "enum": ["INTERVAL", "CAPACITY"] },
    "source": { "enum": ["TENANT", "GATE", "WAITLIST"] },
    "qty": { "type": "integer", "minimum": 1 },
    "sessionId": { "type": ["string", "null"], "format": "uuid" },
    "poolCode": { "type": ["string", "null"], "maxLength": 60 },
    "startsAt": { "type": ["string", "null"], "format": "date-time" },
    "endsAt": { "type": ["string", "null"], "format": "date-time" },
    "resources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["slotCode", "resourceId"],
        "additionalProperties": false,
        "properties": {
          "slotCode": { "type": "string", "maxLength": 60 },
          "resourceId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "seriesId": { "type": ["string", "null"], "format": "uuid" },
    "previous": {
      "type": "object",
      "required": ["qty"],
      "additionalProperties": false,
      "description": "The place the booking left.",
      "properties": {
        "sessionId": { "type": ["string", "null"], "format": "uuid" },
        "poolCode": { "type": ["string", "null"], "maxLength": 60 },
        "startsAt": { "type": ["string", "null"], "format": "date-time" },
        "endsAt": { "type": ["string", "null"], "format": "date-time" },
        "qty": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["slotCode", "resourceId"],
            "additionalProperties": false,
            "properties": {
              "slotCode": { "type": "string", "maxLength": 60 },
              "resourceId": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "bookingId": "0198c1a0-0000-7000-8000-00000000b001",
      "bookingVersion": 3,
      "status": "CONFIRMED",
      "customerRef": "cust-9001",
      "offeringId": "0198c1a0-0000-7000-8000-00000000a002",
      "offeringKind": "INTERVAL",
      "source": "TENANT",
      "qty": 1,
      "startsAt": "2026-11-20T09:00:00Z",
      "endsAt": "2026-11-20T10:00:00Z",
      "resources": [
        { "slotCode": "staff", "resourceId": "0198c1a0-0000-7000-8000-00000000f001" },
        { "slotCode": "room", "resourceId": "0198c1a0-0000-7000-8000-00000000f002" }
      ],
      "previous": {
        "qty": 1,
        "startsAt": "2026-11-19T09:00:00Z",
        "endsAt": "2026-11-19T10:00:00Z",
        "resources": [
          { "slotCode": "staff", "resourceId": "0198c1a0-0000-7000-8000-00000000f001" },
          { "slotCode": "room", "resourceId": "0198c1a0-0000-7000-8000-00000000f002" }
        ]
      },
      "occurredAt": "2026-11-16T11:30:00Z"
    }
  ]
}
