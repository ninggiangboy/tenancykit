# The suite's secrets and endpoints for `docker compose`. Copy to `.env` (which git ignores) and replace every
# placeholder. These are placeholders, not credentials.

# The PostgreSQL superuser the image boots with. It only creates the per-service databases and roles, then the
# services connect as their own unprivileged roles.
POSTGRES_SUPERUSER_PASSWORD=replace-me

# --- Platform ----------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it) of Platform's database.
PLATFORM_MIGRATION_DB_PASSWORD=replace-me
PLATFORM_DB_PASSWORD=replace-me-too
PLATFORM_HOSTNAME=platform.localhost
BASE_DOMAIN=localhost
# ES256 private key in PEM form. Development may leave it blank; the container then generates an ephemeral key.
PLATFORM_TOKEN_SIGNING_KEY=
PLATFORM_TOKEN_ALLOW_EPHEMERAL_KEY=true
PLATFORM_TOKEN_ISSUER=http://platform.localhost:8080
# The realm's issuer and JWKS, so a Keycloak user token verifies. Empty accepts suite tokens only.
# The issuer must be the exact string Keycloak stamps into the token, which is the address the browser signs in at;
# the JWKS address is fetched server-to-server and may use the internal name.
PLATFORM_OIDC_ISSUER_URI=http://localhost:8081/realms/billing
PLATFORM_OIDC_JWK_SET_URI=http://keycloak:8080/realms/billing/protocol/openid-connect/certs
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=
PLATFORM_BOOTSTRAP_ADMIN_TEMPORARY_PASSWORD=
# The billing service client. The secret is stored as the hex SHA-256 of BILLING_REPLICA_CLIENT_SECRET:
# printf %s "$BILLING_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_SERVICE_CLIENT_ID=billing
PLATFORM_SERVICE_CLIENT_SECRET_HASH=replace-me
# The notification service client, Platform's second replica consumer. Its own secret and its own hash:
# printf %s "$NOTIFICATION_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_NOTIFICATION_SERVICE_CLIENT_ID=notification
PLATFORM_NOTIFICATION_SERVICE_CLIENT_SECRET_HASH=replace-me
# The mailroom service client, Platform's third replica consumer. Its own secret and its own hash:
# printf %s "$MAILROOM_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_MAILROOM_SERVICE_CLIENT_ID=mailroom
PLATFORM_MAILROOM_SERVICE_CLIENT_SECRET_HASH=replace-me
# The survey service client, Platform's fourth replica consumer. Its own secret and its own hash:
# printf %s "$SURVEY_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_SURVEY_SERVICE_CLIENT_ID=survey
PLATFORM_SURVEY_SERVICE_CLIENT_SECRET_HASH=replace-me
# The customer service client, Platform's fifth replica consumer. Its own secret and its own hash:
# printf %s "$CUSTOMER_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_CUSTOMER_SERVICE_CLIENT_ID=customer
PLATFORM_CUSTOMER_SERVICE_CLIENT_SECRET_HASH=replace-me
# The loyalty service client, Platform's sixth replica consumer. Its own secret and its own hash:
# printf %s "$LOYALTY_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_LOYALTY_SERVICE_CLIENT_ID=loyalty
PLATFORM_LOYALTY_SERVICE_CLIENT_SECRET_HASH=replace-me
# The booking service client, Platform's seventh replica consumer. Its own secret and its own hash:
# printf %s "$BOOKING_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_BOOKING_SERVICE_CLIENT_ID=booking
PLATFORM_BOOKING_SERVICE_CLIENT_SECRET_HASH=replace-me
# The workflow service client, Platform's eighth replica consumer. Its own secret and its own hash:
# printf %s "$WORKFLOW_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_WORKFLOW_SERVICE_CLIENT_ID=workflow
PLATFORM_WORKFLOW_SERVICE_CLIENT_SECRET_HASH=replace-me
# The attribution service client, Platform's ninth replica consumer. Its own secret and its own hash:
# printf %s "$ATTRIBUTION_REPLICA_CLIENT_SECRET" | shasum -a 256
PLATFORM_ATTRIBUTION_SERVICE_CLIENT_ID=attribution
PLATFORM_ATTRIBUTION_SERVICE_CLIENT_SECRET_HASH=replace-me
# The console's CI client, which registers a UI remote version after publishing a build and holds nothing else. Its own
# secret and its own hash; a leaked one cannot read a tenant or enable a remote:
# printf %s "$FRONTEND_CI_SERVICE_CLIENT_SECRET" | shasum -a 256
PLATFORM_FRONTEND_CI_SERVICE_CLIENT_ID=frontend-ci
PLATFORM_FRONTEND_CI_SERVICE_CLIENT_SECRET_HASH=replace-me

# --- Console -----------------------------------------------------------------------------------------------
# The console's static server renders this Keycloak authority and public client id into /config.json when it starts.
CONSOLE_KEYCLOAK_AUTHORITY=http://localhost:8081/realms/billing
CONSOLE_KEYCLOAK_CLIENT_ID=suite-console
# The origin the console's CSP allows a browser to reach for a sign-in.
CONSOLE_KEYCLOAK_ORIGIN=http://localhost:8081
# The plaintext secret of the frontend-ci service client above, used only by ops/console/deploy-remote.sh. Platform
# stores its hash; CI holds the secret.
FRONTEND_CI_SERVICE_CLIENT_SECRET=replace-me

# --- Keycloak ----------------------------------------------------------------------------------------------
KEYCLOAK_REALM=billing
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-me
PLATFORM_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me
# The suite-smoke client's secret; the direct grant it enables exists only in the development realm.
SMOKE_CLIENT_SECRET=replace-me

# --- RabbitMQ ----------------------------------------------------------------------------------------------
RABBITMQ_ADMIN_USER=rabbitmq
RABBITMQ_ADMIN_PASSWORD=replace-me
PLATFORM_RABBITMQ_PASSWORD=replace-me
BILLING_RABBITMQ_PASSWORD=replace-me
MAILER_RABBITMQ_PASSWORD=replace-me
NOTIFICATION_RABBITMQ_PASSWORD=replace-me
MAILROOM_RABBITMQ_PASSWORD=replace-me
SURVEY_RABBITMQ_PASSWORD=replace-me
CUSTOMER_RABBITMQ_PASSWORD=replace-me
LOYALTY_RABBITMQ_PASSWORD=replace-me
BOOKING_RABBITMQ_PASSWORD=replace-me
WORKFLOW_RABBITMQ_PASSWORD=replace-me
ATTRIBUTION_RABBITMQ_PASSWORD=replace-me

# --- Billing -----------------------------------------------------------------------------------------------
BILLING_MIGRATION_DB_PASSWORD=replace-me
BILLING_DB_PASSWORD=replace-me-too
# The secret whose SHA-256 is PLATFORM_SERVICE_CLIENT_SECRET_HASH; Billing authenticates its replica rebuild with it.
BILLING_REPLICA_CLIENT_SECRET=replace-me
# Master key for secrets at rest (webhook signing secrets, Stripe keys): base64 of 32 random bytes.
# Generate with `openssl rand -base64 32`. Losing it makes stored secrets unreadable.
BILLING_SECRETS_MASTER_KEY=replace-me

# --- Sample tenant -----------------------------------------------------------------------------------------
TENANT_MIGRATION_DB_PASSWORD=replace-me
TENANT_DB_PASSWORD=replace-me-too
# The Platform client credential the tenant exchanges for a suite token; created through Platform's
# tenant-system credential management and shown once.
SAMPLE_TENANT_PLATFORM_CLIENT_ID=
SAMPLE_TENANT_PLATFORM_CLIENT_SECRET=
SAMPLE_TENANT_WEBHOOK_SECRET=

# --- Mailer ------------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
MAILER_MIGRATION_DB_PASSWORD=replace-me
MAILER_DB_PASSWORD=replace-me-too
# Master key for tenant credentials at rest: base64 of 32 random bytes, `openssl rand -base64 32`.
# Losing it makes every TENANT credential row undecryptable, so it needs the same backup story as the database.
MAILER_SECRETS_MASTER_KEY=replace-me
# The suite's own sender, used until a tenant registers its own credential for a from-key.
MAILER_DEFAULT_FROM_ADDRESS=noreply@example.com
MAILER_DEFAULT_FROM_NAME=TenancyKit

# --- Notification ------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
NOTIFICATION_MIGRATION_DB_PASSWORD=replace-me
NOTIFICATION_DB_PASSWORD=replace-me-too
# The notification replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_NOTIFICATION_SERVICE_CLIENT_SECRET_HASH above. It is never shared with Billing's client.
NOTIFICATION_REPLICA_CLIENT_SECRET=replace-me

# --- Mailroom ----------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
MAILROOM_MIGRATION_DB_PASSWORD=replace-me
MAILROOM_DB_PASSWORD=replace-me-too
# The mailroom replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_MAILROOM_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
MAILROOM_REPLICA_CLIENT_SECRET=replace-me
# The HMAC key that signs open, click and unsubscribe tokens. Losing it invalidates links in mail already sent;
# rotating it means adding a new key id and keeping the old one until its mail is no longer read.
MAILROOM_TRACKING_KEY_ID=k1
MAILROOM_TRACKING_SECRET=replace-me
# Where a recipient reaches /t/...; must be a hostname Caddy serves and a prefix it forwards to mailroom-api.
MAILROOM_PUBLIC_BASE_URL=http://localhost:8090/mailroom

# --- Survey ------------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
SURVEY_MIGRATION_DB_PASSWORD=replace-me
SURVEY_DB_PASSWORD=replace-me-too
# The survey replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_SURVEY_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
SURVEY_REPLICA_CLIENT_SECRET=replace-me
# The HMAC key that signs link tokens. Losing it invalidates links already handed out; rotating it means adding a new
# key id and keeping the old one until its links are no longer opened.
SURVEY_LINK_KEY_ID=k1
SURVEY_LINK_SECRET=replace-me
# Master key for secrets at rest (webhook signing secrets): base64 of 32 random bytes.
SURVEY_SECRETS_MASTER_KEY=replace-me
# Where a respondent reaches /p/...; must be a hostname Caddy serves and a prefix it forwards to survey-api.
SURVEY_PUBLIC_BASE_URL=http://localhost:8090/survey
# SeaweedFS (S3): the server's own endpoint and the host a browser reaches for a presigned PUT. The access key and
# secret also become the one identity the compose SeaweedFS accepts.
SURVEY_S3_ENDPOINT=http://seaweedfs:9000
SURVEY_S3_PUBLIC_ENDPOINT=http://localhost:9000
SURVEY_S3_BUCKET=survey-uploads
SURVEY_S3_ACCESS_KEY=minio
SURVEY_S3_SECRET_KEY=replace-me

# --- Customer ---------------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
CUSTOMER_MIGRATION_DB_PASSWORD=replace-me
CUSTOMER_DB_PASSWORD=replace-me-too
# The customer replica client's secret; Platform stores only its SHA-256, in PLATFORM_CUSTOMER_SERVICE_CLIENT_SECRET_HASH above.
# It is never shared with another service's client.
CUSTOMER_REPLICA_CLIENT_SECRET=replace-me
# Master key for secrets at rest (webhook signing secrets): base64 of 32 random bytes, `openssl rand -base64 32`.
# Losing it makes every stored endpoint secret unreadable, so it needs the same backup story as the database.
CUSTOMER_SECRETS_MASTER_KEY=replace-me
# Where a Tenant's system reaches /customer/...; must be a hostname Caddy serves and a prefix it forwards to customer-api.
CUSTOMER_PUBLIC_BASE_URL=http://localhost:8090/customer

# --- Loyalty -----------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
LOYALTY_MIGRATION_DB_PASSWORD=replace-me
LOYALTY_DB_PASSWORD=replace-me-too
# The loyalty replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_LOYALTY_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
LOYALTY_REPLICA_CLIENT_SECRET=replace-me
# Master key for secrets at rest (webhook signing secrets): base64 of 32 random bytes, `openssl rand -base64 32`.
# Losing it makes every stored endpoint secret unreadable, so it needs the same backup story as the database.
LOYALTY_SECRETS_MASTER_KEY=replace-me
# Where a Tenant's system reaches /loyalty/...; must be a hostname Caddy serves and a prefix it forwards to
# loyalty-api.
LOYALTY_PUBLIC_BASE_URL=http://localhost:8090/loyalty

# --- Booking -----------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
BOOKING_MIGRATION_DB_PASSWORD=replace-me
BOOKING_DB_PASSWORD=replace-me-too
# The booking replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_BOOKING_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
BOOKING_REPLICA_CLIENT_SECRET=replace-me
# The HMAC key that signs customer tokens for the public gate. Rotating it means adding a new key id and keeping the
# old one until the tokens it signed have expired; the tokens are short-lived by design.
BOOKING_TOKEN_KEY_ID=k1
BOOKING_TOKEN_SECRET=replace-me
# Master key for secrets at rest (webhook signing secrets): base64 of 32 random bytes, `openssl rand -base64 32`.
# Losing it makes every stored endpoint secret unreadable, so it needs the same backup story as the database.
BOOKING_SECRETS_MASTER_KEY=replace-me
# Where a Tenant's customer reaches /booking/p/...; must be a hostname Caddy serves and a prefix it forwards to
# booking-api.
BOOKING_PUBLIC_BASE_URL=http://localhost:8090/booking

# --- Workflow ----------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
WORKFLOW_MIGRATION_DB_PASSWORD=replace-me
WORKFLOW_DB_PASSWORD=replace-me-too
# The workflow replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_WORKFLOW_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
WORKFLOW_REPLICA_CLIENT_SECRET=replace-me
# Master key for connection and Platform-credential secrets at rest: base64 of 32 random bytes, `openssl rand -base64
# 32`. The key id travels with every ciphertext so a key can rotate; losing the key makes stored connection secrets
# unreadable.
WORKFLOW_SECRET_KEY=replace-me
WORKFLOW_SECRET_KEY_ID=k1
# Where a Tenant's system reaches /workflow/...; must be a hostname Caddy serves and a prefix it forwards to
# workflow-api.
WORKFLOW_PUBLIC_BASE_URL=http://localhost:8090/workflow

# --- Attribution -------------------------------------------------------------------------------------------
# Owner role (Flyway migrates as it) and app role (the service connects as it, and row-level security applies to it).
ATTRIBUTION_MIGRATION_DB_PASSWORD=replace-me
ATTRIBUTION_DB_PASSWORD=replace-me-too
# The attribution replica client's secret; Platform stores only its SHA-256, in
# PLATFORM_ATTRIBUTION_SERVICE_CLIENT_SECRET_HASH above. It is never shared with another service's client.
ATTRIBUTION_REPLICA_CLIENT_SECRET=replace-me
# The HMAC key that signs click tokens, and the key the daily visitor hash uses. The app refuses to start without
# either, because hashing or signing with a public default would make every link forgeable.
ATTRIBUTION_CLICK_KEY_ID=k1
ATTRIBUTION_CLICK_SECRET=replace-me
ATTRIBUTION_VISITOR_HASH_KEY=replace-me
# Where a visitor reaches /go/... and a browser posts /t/...; must be a hostname Caddy serves.
ATTRIBUTION_PUBLIC_BASE_URL=http://localhost:8090
