{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/workflow/graph.schema.json",
  "title": "Workflow graph",
  "description": "One version of a workflow: the node the instance starts at and the nodes it can reach. Nodes act on the world only through their own node type; the structure is fixed by this shape and the meaning by the checker (contracts/workflow/README.md). Limits the schema states: 200 nodes and 400 edges. A graph has exactly one trigger, which is the start; it ends at an end or a fail node; a parallel joins at a join node; a cycle repeats only through a for-each; a compensation names an http node. Edges are the `next`, `on_error`, `on_timeout`, `body` and `compensate` members, a branch's cases and else, and a parallel's branches and join.",
  "type": "object",
  "required": ["start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "start": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The id of the one trigger node."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "next": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "trigger",
            "set",
            "http",
            "branch",
            "delay",
            "wait",
            "task",
            "parallel",
            "join",
            "foreach",
            "subflow",
            "end",
            "fail"
          ]
        },
        "next": {
          "$ref": "#/$defs/next"
        },
        "on_error": {
          "$ref": "#/$defs/next"
        },
        "on_timeout": {
          "$ref": "#/$defs/next"
        },
        "compensate": {
          "$ref": "#/$defs/next",
          "description": "An http node of this graph that undoes this node when the instance is rolled back."
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          },
          "description": "A set node's variables, each an expression."
        },
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          }
        },
        "body": {
          "$ref": "#/$defs/expression"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["when", "next"],
            "additionalProperties": false,
            "properties": {
              "when": {
                "$ref": "#/$defs/expression"
              },
              "next": {
                "$ref": "#/$defs/next"
              }
            }
          }
        },
        "else": {
          "$ref": "#/$defs/next"
        },
        "duration": {
          "type": "string",
          "description": "An ISO-8601 duration, for example PT10M."
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The event type a wait node waits for."
        },
        "match": {
          "$ref": "#/$defs/expression"
        },
        "timeout": {
          "type": "string",
          "description": "An ISO-8601 duration after which the wait takes its on_timeout edge."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "assignee": {
          "type": "object",
          "minProperties": 1,
          "description": "Either {\"user\": \"<uuid>\"} or {\"group\": \"<uuid>\"}.",
          "properties": {
            "user": {
              "type": "string"
            },
            "group": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "due": {
          "type": "string",
          "description": "An ISO-8601 duration after which a task is due."
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "uniqueItems": true,
          "description": "The nodes the branches start at. A branch is collected at its join under its own node id.",
          "items": {
            "$ref": "#/$defs/next"
          }
        },
        "join": {
          "$ref": "#/$defs/next",
          "description": "The join node where this fan-out converges."
        },
        "mode": {
          "type": "string",
          "enum": ["all", "any", "n_of"],
          "description": "What a join waits for: every branch, the first, or count branches. Defaults to all."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many arrivals fire an n_of join."
        },
        "items": {
          "$ref": "#/$defs/expression"
        },
        "each": {
          "$ref": "#/$defs/next",
          "description": "The node one iteration starts at."
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The code of the definition a subflow runs."
        },
        "input": {
          "$ref": "#/$defs/expression"
        },
        "reason": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["trigger", "set", "http", "delay", "wait", "task", "join", "subflow"] } }
          },
          "then": { "required": ["next"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "set" } }
          },
          "then": { "required": ["values"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "http" } }
          },
          "then": { "required": ["app", "method", "path"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "branch" } }
          },
          "then": { "required": ["cases"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "delay" } }
          },
          "then": { "required": ["duration"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "wait" } }
          },
          "then": { "required": ["event"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "task" } }
          },
          "then": { "required": ["title", "assignee"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "parallel" } }
          },
          "then": { "required": ["branches", "join"] }
        },
        {
          "if": {
            "required": ["type", "mode"],
            "properties": { "type": { "const": "join" }, "mode": { "const": "n_of" } }
          },
          "then": { "required": ["count"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "foreach" } }
          },
          "then": { "required": ["items", "each"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "subflow" } }
          },
          "then": { "required": ["definition"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "end" } }
          },
          "then": { "not": { "required": ["next"] } }
        }
      ]
    },
    "expression": {
      "$ref": "expression.schema.json"
    }
  }
}
