{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/commands/notification.requested.schema.json",
  "title": "Notification requested",
  "description": "An app asks the Notification Hub to deliver one notification. The Hub renders the template and sends it over the requested channels; a channel the tenant has not enabled is dropped. This schema describes the `data` member; the envelope is described in ../messaging/README.md.",
  "type": "object",
  "required": [
    "request_id",
    "template_key",
    "locale",
    "channels",
    "recipients",
    "variables"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Chosen by the requesting app; the Hub deduplicates on it."
    },
    "template_key": {
      "type": "string",
      "description": "A template the Hub knows, such as invoice-issued."
    },
    "locale": {
      "type": "string",
      "description": "BCP 47 language tag, such as en or vi.",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "in_app"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Email recipient",
            "required": [
              "type",
              "address"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "email"
              },
              "address": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "User recipient",
            "required": [
              "type",
              "user_id"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "user"
              },
              "user_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      }
    },
    "variables": {
      "type": "object",
      "description": "Values substituted into the template; JSON scalars only.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "link": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
