{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.ngb.dev/events/booking/series.cancelled.schema.json",
  "title": "Series cancelled",
  "description": "A series was cancelled and its future occurrences released; occurrences already confirmed are reported in `cancelledOccurrences` because the Tenant decides their own policy. The event's `aggregate` is `series/<seriesId>`. This schema describes the `data` member; the envelope is described in ../../messaging/README.md.",
  "type": "object",
  "required": [
    "seriesId",
    "seriesVersion",
    "offeringId",
    "customerRef",
    "status",
    "cancelledOccurrences",
    "occurredAt"
  ],
  "additionalProperties": false,
  "properties": {
    "seriesId": { "type": "string", "format": "uuid" },
    "seriesVersion": { "type": "integer", "minimum": 1 },
    "offeringId": { "type": "string", "format": "uuid" },
    "customerRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "const": "CANCELLED" },
    "cancelledOccurrences": { "type": "integer", "minimum": 0, "description": "Occurrences that were cancelled by this call." },
    "occurredAt": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "seriesId": "0198c1a0-0000-7000-8000-00000000e001",
      "seriesVersion": 2,
      "offeringId": "0198c1a0-0000-7000-8000-00000000a002",
      "customerRef": "cust-9002",
      "status": "CANCELLED",
      "cancelledOccurrences": 6,
      "occurredAt": "2026-11-20T08:00:00Z"
    }
  ]
}
